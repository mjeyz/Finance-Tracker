<%- include('partials/base.ejs') %>

<body>
<div class="flash-stack page-flash-stack">
    <% if (error && error.length > 0) { %>
        <% error.forEach(function (msg) { %>
            <div class="flash-message flash-error"><%= msg %></div>
        <% }) %>
    <% } %>
    <% if (success && success.length > 0) { %>
        <% success.forEach(function (msg) { %>
            <div class="flash-message flash-success"><%= msg %></div>
        <% }) %>
    <% } %>
    <% if (info && info.length > 0) { %>
        <% info.forEach(function (msg) { %>
            <div class="flash-message flash-info"><%= msg %></div>
        <% }) %>
    <% } %>
</div>


<div class="sidebar-overlay" id="sidebarOverlay"></div>
<!--Sidebar-->
<%- include ("partials/sidebar") %>

<!--Top Navbar-->
<%- include ("partials/top-navbar") %>


<main class="main-content">

    <h1 class="dashboard-heading">Hi <%= user.name %></h1>
    <p class="dashboard-subtitle">Your financial overview at a glance</p>

    <div class="update-income-cantainer">
        <button class="update-income-btn" id="updateIncomeBtn"><i class="fa-solid fa-plus"></i> Update income</button>
    </div>


    <div class="update-income-overlay" id="updateIncomeOverlay">
        <div class="update-income-model">

            <div class="update-income-header">
                <div class="title"><i class="fa-solid fa-plus"></i> Add or update income</div>
                <button class="close-btn" id="incomeCloseBtn" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>


            <div class="update-income-model-body">
                <form class="update-income-form" id="incomeForm" method="POST" data-submit-route="/api/update/income">

                    <div class="form-group">
                        <label for="incomeInput">Income</label>
                        <input type="text" placeholder="20000" name="income" id="incomeInput" required>
                    </div>

                    <div class="form-group">
                        <label for="incomeInput">Expenses</label>
                        <input type="text" placeholder="20000" name="expense" id="incomeInput" required>
                    </div>

                    <div class="form-action">
                        <button class="btn btn-secondary" id="incomeCancelModel" type="button">Cancel</button>
                        <button class="btn btn-primary" id="incomeSubmitBtn" type="submit">Submit</button>
                    </div>
                </form>


            </div>
        </div>
    </div>

    <div class="status">
        <div class="stat-card total-income">
            <span class="card-subtitle">Total Income</span>
            <% if (user.income) { %>
                <p class="amount income"><%= user.income %> PKR</p>
            <% } else { %>
                <p class="amount income">0 PKR</p>
            <% } %>
        </div>
        <div class="stat-card current-balance">
            <span class="card-subtitle">Current Balance</span>
            <p class="amount balance">PKR 0</p>
        </div>
        <div class="stat-card expenses">
            <span class="card-subtitle">Expenses</span>
            <% if (user.expenses) { %>
                <p class="amount expense"><%= user.expenses %></p>
            <% } else { %>
                <p class="amount expense">0 PKR</p>
            <% } %>
        </div>
    </div>

    <div class="button-group">
        <button class="tab-btn transaction-btn active" id="transactionBtn">Transaction</button>
        <button class="tab-btn envent-btn" id="eventBtn">Upcoming Event</button>
        <button class="tab-btn saving-btn" id="savingBtn">Saving</button>
    </div>

    <div class="display-panel">
        <div class="list-header">
            <h3 id="dynamicTitle">Transaction History</h3>
        </div>
        <div id="listContainer" class="listContainer active">
            <%- include ("transaction-list") %>

            <% if (transaction.length > 4 || events.length > 4 || saving.length > 2) { %>
                <div class="view-more" id="viewMore">
                    <a href="/transaction" id="viewMoreLink">View more....</a>
                </div>
            <% } %>
            <button class="add-transaction" id="addTransaction"><i class="fa-solid fa-plus"></i> Add Transaction
            </button>

            <!-- Overlay Form -->
            <%- include("overlay-form") %>
        </div>

        <div class="chart-cantainer">

            <div class="pie-chart graph">
                <canvas id="pieChart" style="width:100%;max-width:700px;height: 400px"></canvas>
            </div>

            <div class="line-chart graph">
                <canvas id="lineChart" style="width:100%;max-width:700px;height: 400px"></canvas>
            </div>
        </div>
</main>

<script src="/js/index.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var sidebarLink = document.querySelector('.sidebar .nav-link[href="/"]');

        if (sidebarLink) {
            sidebarLink.classList.add("active");
        }
    });
</script>
</body>
</html>
