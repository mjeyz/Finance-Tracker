<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <% if(is_edit) { %>
    <title>FinTrack || Edit Transaction</title>
        <% } else { %>
    <title>FinTrack || Create Transaction</title>
    <% } %>
    <link rel="stylesheet" href="/css/login.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
<div class="form-card">
    <div class="model">
        <% if (error && error.length > 0) { %>
            <div class="flash-stack">
                <% error.forEach(function (msg) { %>
                    <div class="flash-message flash-error"><%= msg %></div>
                <% }) %>
            </div>
        <% } %>
        <% if (success && success.length > 0) { %>
            <div class="flash-stack">
                <% success.forEach(function (msg) { %>
                    <div class="flash-message flash-success"><%= msg %></div>
                <% }) %>
            </div>
        <% } %>
        <% if (info && info.length > 0) { %>
            <div class="flash-stack">
                <% info.forEach(function (msg) { %>
                    <div class="flash-message flash-info"><%= msg %></div>
                <% }) %>
            </div>
        <% } %>
        <form class="login-form add-form" action="<% is_edit ? `/edit/transaction/${transaction.id}` : '/add-transaction'%>" method="POST">
            <div class="form-header" style="margin-bottom: 1rem;">
                <% if(is_edit) { %>
                <h1 class="form-heading">Edit Transaction</h1>
                <% } else { %>
                <h1 class="form-heading">Create Transaction</h1>

                    <% } %>
                <p class="form-subheading">Set a target and track your progress</p>
            </div>

            <div class="form-group">
                <label for="amount">Amount</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-rupee-sign icon"></i>
                    <input type="number" id="amount" name="amount" required placeholder="eg. 4666" value="<%= transaction.amount %>">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="category">Category</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-layer-group icon"></i>
                        <select id="category" name="transactionCategory" required>
                            <option value="" disabled selected>Select category</option>
                            <option value="Food" <%= transaction.category == "Food"? "selected": "" %> >Food and dining</option>
                            <option value="Transportation <%= transaction.category == "Transportation"? "selected": "" %> ">Transportation</option>
                            <option value="Rent" <%= transaction.category == "Rent"? "selected": "" %> >House Rent</option>
                            <option value="entertainment" <%= transaction.category == "entertainment"? "selected": "" %> >Entertainment</option>
                            <option value="Shopping" <%= transaction.category == "Shopping"? "selected": "" %> >Shopping</option>
                            <option value="Healthcare" <%= transaction.category == "Healthcare"? "selected": "" %> >Healthcare</option>
                            <option value="Personal Care" <%= transaction.category == "Personal Care"? "selected": "" %> >Personal care</option>
                            <option value="Saving" <%= transaction.category == "Saving"? "selected": "" %> >Saving and investment</option>
                            <option value="Other" <%= transaction.category == "Other"? "selected": "" %> >Other</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label for="type">Type</label>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-money-bill-trend-up icon"></i>
                        <select id="type" name="type" required>
                            <option value="" disabled selected>Select Type</option>
                            <option value="income" <%= transaction.type == "income" ? "selected": "" %> >Income</option>
                            <option value="expense" <%= transaction.type == "expense" ? "selected": "" %> >Expense</option>
                            <option value="other" <%= transaction.type == "other" ? "selected": "" %> >Other</option>
                        </select>
                    </div>
                </div>
            </div>



              <div class="form-row">
                    <div class="form-group">
                        <label for="date">Transaction Date</label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-calendar-days icon"></i>
                        <input id="date" type="date" placeholder="Date" name="date" value="<%= transaction ? formattedDate : "" %>" />
                            </div>
                    </div>

                    <div class="form-group">
                        <label for="paymentMethod">Payment method</label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-wallet icon"></i>
                        <select id="paymentMethod" name="method">
                             <option value="" disabled selected>Select Payment Method</option>
                            <option value="Cash" <%= transaction.method == "cash" ? "selected": "" %>>Cash</option>
                            <option value="Credit Card" <%= transaction.method == "Credit Card" ? "selected": "" %>>Credit Card</option>
                            <option value="EasyPaisa" <%= transaction.method == "EasyPaisa" ? "selected": "" %>>EasyPaisa</option>
                            <option value="JazzCash" <%= transaction.method == "JazzCash" ? "selected": "" %>>Jazz Cash</option>
                            <option value="Bank Transfer" <%= transaction.method == "Bank Transfer" ? "selected": "" %>>Bank Transfer</option>
                            <option value="PayPal" <%= transaction.method == "PayPal" ? "selected": "" %>>Paypal</option>
                            <option value="Cryptocurrency" <%= transaction.method == "Cryptocurrency" ? "selected": "" %>>Cryptocurrency</option>
                            <option value="Other" <%= transaction.method == "Other" ? "selected": "" %>>Other</option>
                        </select>
                        </div>
                    </div>
                </div>

            <div class="form-group">
                <label for="savingDescription">Description</label>
                <textarea id="savingDescription"
                          name="description"
                          placeholder="Write a short note...."
                          maxlength="250"
                          rows="4"
                ><%= transaction.description %></textarea>
            </div>

            <button type="submit" class="submit-btn">Save Transaction</button>
        </form>
    </div>
</div>
<script src="/js/index.js"></script>
</body>
</html>