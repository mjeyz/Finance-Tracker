<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <% if(is_edit) {%>
    <title>FinTrack || Edit Event</title>
        <%} else {%>
    <title>FinTrack || Create Event</title>

    <% } %>
    <link rel="stylesheet" href="/css/login.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
<div class="form-card">
    <div class="model">
        <% if (error && error.length > 0) { %>
            <div class="flash-stack">
                <% error.forEach(function (msg) { %>
                    <div class="flash-message flash-error"><%= msg %></div>
                <% }) %>
            </div>
        <% } %>
        <% if (success && success.length > 0) { %>
            <div class="flash-stack">
                <% success.forEach(function (msg) { %>
                    <div class="flash-message flash-success"><%= msg %></div>
                <% }) %>
            </div>
        <% } %>
        <% if (info && info.length > 0) { %>
            <div class="flash-stack">
                <% info.forEach(function (msg) { %>
                    <div class="flash-message flash-info"><%= msg %></div>
                <% }) %>
            </div>
        <% } %>
        <form class="login-form add-form" action="/add-event" method="POST">
            <div class="form-header" style="margin-bottom: 1rem;">
                <% if (is_edit) { %>
                <h1 class="form-heading">Edit Event</h1>
                <% } else { %>
                <h1 class="form-heading">Create Event</h1>
                    <% } %>
                <p class="form-subheading">Set a target and track your progress</p>
            </div>

            <div class="form-group">
                <label for="eventName">Event Name </label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-bullseye icon"></i>
                    <input type="text" id="eventName" name="eventName" required placeholder="e.g. Design Workshop" value="<%= event.name%>">
                </div>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-map icon"></i>
                    <input type="text" id="location" name="location" required placeholder="Ali Town Lahore" value="<%= event.location%>">
                </div>
            </div>

            <div class="form-group">
                <label for="eventDate">Event Date</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-calendar-days icon"></i>
                    <input type="date" id="eventDate" name="eventDate" required value="<%= event ? formatedDate : ""%>">
                </div>
            </div>

            <div class="form-group">
                <label for="eventTime">Time</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-clock icon"></i>
                    <input type="time" id="eventTime" name="eventTime" required value="<%= %>">
                </div>
            </div>

            <div class="form-group">
                <label for="priority">Event Priority</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-font-awesome icon"></i>
                    <select id="priority" name="priority" required >
                        <option value="" disabled selected>Select Priority</option>
                        <option value="Low Priority">Low Priority</option>
                        <option value="Mid Priority">Mid Priority</option>
                        <option value="High Priority">High Priority</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label for="savingDescription">Note</label>
                <textarea
                        id="savingDescription"
                        name="description"
                        placeholder="Write a short note...."
                        maxlength="250"
                        rows="4"
                ><%= event.description %></textarea>
            </div>

            <button type="submit" class="submit-btn">Create Event</button>
        </form>
    </div>
</div>
<script src="/js/index.js"></script>
</body>
</html>