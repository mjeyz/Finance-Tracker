<%- include ("partials/base.ejs") %>
<%- include ("partials/sidebar.ejs") %>
<%- include ("partials/top-navbar.ejs") %>

<main class="event-main">
    <section class="event-page">
        <header class="event-header">
            <div class="event-heading">
                <h1 class="event-title">Events</h1>
                <p class="event-subtitle">Stay organized and never miss an important date.</p>
            </div>

            <div class="event-actions">
                <a class="event-action event-action-primary" href="/add-event" style="text-decoration: none"><i
                            class="bx bx-plus"></i> Add Event</a>
                <button class="event-action event-action-ghost event-filter-btn"><i class="bx bx-filter-alt"></i>Filter
                </button>
            </div>
        </header>

        <section class="event-summary-grid" aria-label="Events summaries">
            <!--            Upcoming Event-->
            <article class="upcoming-event-summray-card event-summary-card">
                <div class="event-summary__icon upcoming-event-summary-icon ">
                    <i class="fa-regular fa-calendar-days"></i>
                </div>
                <div class="event-summary-content ">
                    <span class="event-card-label">Upcoming Events</span>
                    <strong class="event-card-value"><%= upcomingCount %></strong>
                    <div class="event-card-mete">
                        <span>From today</span>
                        <span class="event-card-delta"><i class="fa-solid fa-arrow-trend-up"></i></span>
                    </div>
                </div>
            </article>
            <!--            Birthdays-->
            <article class="birthday-event-summray-card event-summary-card">
                <div class="event-summary__icon birthday-event">
                    <i class="bx bx-gift"></i>
                </div>
                <div class="event-summary-content">
                    <span class="event-card-label">High Priority</span>
                    <strong class="event-card-value"><%= highPriorityCount %></strong>
                    <div class="event-card-mete">
                        <span>Needs attention</span>
                        <span class="event-card-delta"><i class="fa-solid fa-bolt"></i></span>
                    </div>
                </div>
            </article>
            <!--            Bill Reminder-->
            <article class="bill-reminder-event-summray-card event-summary-card">
                <div class="event-summary__icon bill-reminder__event">
                    <i class="fa-solid fa-money-bill-1"></i>
                </div>
                <div class="event-summary-content">
                    <span class="event-card-label">This Month</span>
                    <strong class="event-card-value"><%= thisMonthCount %></strong>
                    <div class="event-card-mete">
                        <span>This Month</span>
                        <span class="event-card-delta"><i class="fa-regular fa-calendar"></i></span>
                    </div>
                </div>
            </article>
            <!--            Total Event-->
            <article class="total-event-summray-card event-summary-card">
                <div class="event-summary__icon total-event">
                    <i class="bx bx-flag"></i>
                </div>
                <div class="event-summary-content">
                    <span class="event-card-label">Total</span>
                    <strong class="event-card-value"><%= totalCount %></strong>
                    <div class="event-card-mete">
                        <span>All events</span>
                        <span class="event-card-delta"><i class="fa-solid fa-check"></i></span>
                    </div>
                </div>
            </article>
        </section>

        <section class="event-content">
            <div class="event-calender">
                <div class="calender-header">
                    <div class="calender-title">
                        <span class="c-title">Calendar</span>
                    </div>
                    <div class="calender-main">
                        <button class="nav-btn" id="prevMonthBtn" aria-label="Previous month">
                            <i class="fas fa-chevron-left"></i>
                        </button>

                        <div class="month-year" id="monthYearDisplay">
                            August <span class="year">2026</span>
                        </div>

                        <button class="nav-btn" id="nextMonthBtn" aria-label="Next month">
                            <i class="fas fa-chevron-right"></i>
                        </button>

                        <button class="today" type="button" id="todayBtn">Today</button>
                    </div>
                </div>

                <div class="main-calender">
                    <div class="weakdays">
                        <span>Sun</span>
                        <span>Mon</span>
                        <span>Tue</span>
                        <span>Wed</span>
                        <span>Thu</span>
                        <span>Fri</span>
                        <span>Sat</span>
                    </div>
                    <div class="days-grid" id="daysGrid">

                    </div>
                    <div class="legend">
                        <span class="legend-item"><span class="legend-dot orange"></span> Bill</span>
                        <span class="legend-item"><span class="legend-dot green"></span> Payment</span>
                        <span class="legend-item"><span class="legend-dot blue"></span> Birthday</span>
                        <span class="legend-item"><span class="legend-dot purple"></span> Reminder</span>
                        <span class="legend-item"><span class="legend-dot pink"></span> Other</span>
                    </div>
                </div>
            </div>

            <div class="upcoming-event-list">
                <div class="event-cantainer-header">
                    <span class="upcoming-event-title">Upcoming Events</span>
                    <a href="/">View All</a>
                </div>
                <% if (events.length > 0) { %>


                    <% events.forEach(ev => { %>


                        <div class="event" data-id="<%= ev.id %>" data-event-date="<%= ev.date %>">
                            <div class="event-div-1">
                                <div class="event-icon"><i class="fa-regular fa-calendar-check"></i></div>

                                <div class="event-labels">
                                    <span class="title"><%= ev.name %></span>
                                    <span class="subtitle"><i class="fa-solid fa-location-dot"></i> <%= ev.location || "No location added" %></span>
                                </div>
                            </div>
                            <div class="event-div-2">
                                <div class="event-date">
                                    <span class="event-date js-event-date"><%= ev.date %></span>
                                    <span class="event-day js-event-day">--</span>
                                </div>

                                <div class="event-time js-event-time"><%= ev.time || "All day" %></div>
                            </div>
                            <div class="dropdown">
                                <div class="more-action" onclick="activeGoalDropdown(this)"><i class="fa-solid fa-ellipsis-vertical"></i></div>
                                <div class="dropdown-content">
                                    <a href="/edit/event/<%= ev.id %>">Edit Event</a>
                                    <a class="dropdown-delete">Delete Event</a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                <div class="empty-message event-empty-state">
                    <i class="fa-regular fa-calendar-plus"></i>
                    <strong>No events yet</strong>
                    <span>Add your first event to keep your plans in one place.</span>
                    <a class="event-action event-action-primary" href="/add-event">Create an event</a>
                </div>
            <% }%>
            </div>
        </section>
        <div class="tip">
            <i class="fas fa-lightbulb"></i>
            <span><strong>Tip</strong>: Add your bills, payment and important dates to stay on track with your finances.</span>
        </div>
    </section>
</main>

<script id="eventsData" type="application/json"><%- JSON.stringify(events).replace(/</g, '\\u003c') %></script>
<script src="/js/index.js"></script>

<script>

    document.addEventListener("DOMContentLoaded", function () {
        var sidebarLink = document.querySelector('.sidebar .nav-link[href="/events"]');

        if (sidebarLink) {
            sidebarLink.classList.add("active");
        }
    });
</script>
