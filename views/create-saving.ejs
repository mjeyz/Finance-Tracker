<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <% if (is_edit) { %>
        <title>FinTrack || Edit Goal</title>
    <% } else { %>
        <title>FinTrack || Create Goal</title>
    <% } %>
    <link rel="stylesheet" href="/css/login.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
<div class="form-card">
    <div class="model">
        <% if (error && error.length > 0) { %>
            <div class="flash-stack">
                <% error.forEach(function (msg) { %>
                    <div class="flash-message flash-error"><%= msg %></div>
                <% }) %>
            </div>
        <% } %>
        <% if (success && success.length > 0) { %>
            <div class="flash-stack">
                <% success.forEach(function (msg) { %>
                    <div class="flash-message flash-success"><%= msg %></div>
                <% }) %>
            </div>
        <% } %>
        <% if (info && info.length > 0) { %>
            <div class="flash-stack">
                <% info.forEach(function (msg) { %>
                    <div class="flash-message flash-info"><%= msg %></div>
                <% }) %>
            </div>
        <% } %>
        <form class="login-form add-form" action="<% is_edit ? `/edit/goal/${ goal.id}` : '/add-saving'%>" method="POST">
            <div class="form-header" style="margin-bottom: 1rem;">
                <% if (is_edit) { %>
                    <h1 class="form-heading">Edit Goal</h1>
                <% } else { %>
                    <h1 class="form-heading">Create Goal</h1>
                <% } %>
                <p class="form-subheading">Set a target and track your progress</p>
            </div>

            <div class="form-group">
                <label for="purpose">Enter Name</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-bullseye icon"></i>
                    <input type="text" id="purpose" name="purpose" required placeholder="Dream Vacation"
                           value="<%= goal ? goal.goal : "" %>">
                </div>
            </div>

            <div class="form-group">
                <label for="targetAmount">Target Amount</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-piggy-bank icon"></i>
                    <input type="number" id="targetAmount" name="targetAmount" required placeholder="9000"
                           value="<%= goal ? goal.targetamount : "" %>">
                </div>
            </div>

            <div class="form-group">
                <label for="savedAmount">Saved Amount</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-sack-dollar icon"></i>
                    <input type="number" id="savedAmount" name="savedAmount" required placeholder="800"
                           value="<%= goal ? goal.savedamount : "" %>">
                </div>
            </div>

            <div class="form-group">
                <label for="targetDate">Target Date</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-calendar-days icon"></i>
                    <input type="date" id="targetDate" name="targetDate" required
                           value="<%= goal ? formattedDate : "" %>">
                </div>
            </div>

            <div class="form-group">
                <label for="savingDescription">Description</label>
                <textarea
                        id="savingDescription"
                        name="description"
                        placeholder="Write a short note...."
                        rows="4"
                ><%= goal ? goal.description : "" %></textarea>
            </div>

            <button type="submit" class="submit-btn">Create goal</button>
        </form>
    </div>
</div>
<script src="/js/index.js"></script>
</body>
</html>