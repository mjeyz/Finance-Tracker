<header class="header top-nav">
    <button class="toggle-btn" id="toggleBtn" aria-label="Toggle sidebar">
        <i class="fas fa-bars"></i>
    </button>

    <div class="search-group">
        <i class="fas fa-search icon"></i>
        <input
                type="search"
                id="dashboardSearch"
                placeholder="Search transactions, events, or goals..."
                name="search"
                class="search-input"
                aria-label="Search dashboard items"/>
    </div>
    <div class="user-menu">
        <div class="notifications">
            <i class="bx bx-bell" aria-hidden="true"></i>
        </div>
        <div class="profile">
            <div class="avatar">
                <%= user.name[0].toUpperCase() %>
            </div>
            <span class="profile-email"><%= user.email %></span>
        </div>
    </div>
</header>