<div class="flash-stack page-flash-stack" aria-live="polite" aria-atomic="true">
    <% if (error && error.length > 0) { %>
        <% error.forEach(function (msg) { %>
            <div class="flash-message flash-error" role="alert">
                <span class="flash-message-text"><%= msg %></span>
                <button class="flash-close" type="button" aria-label="Dismiss message">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        <% }) %>
    <% } %>
    <% if (success && success.length > 0) { %>
        <% success.forEach(function (msg) { %>
            <div class="flash-message flash-success" role="alert">
                <span class="flash-message-text"><%= msg %></span>
                <button class="flash-close" type="button" aria-label="Dismiss message">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        <% }) %>
    <% } %>
    <% if (info && info.length > 0) { %>
        <% info.forEach(function (msg) { %>
            <div class="flash-message flash-info" role="alert">
                <span class="flash-message-text"><%= msg %></span>
                <button class="flash-close" type="button" aria-label="Dismiss message">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        <% }) %>
    <% } %>
</div>
