<%- include ("partials/base.ejs") %>
<%- include ("partials/sidebar.ejs") %>
<%- include ("partials/top-navbar.ejs") %>

<%
const rows = Array.isArray(transaction) ? transaction : [];
const currentMonthLabel = new Intl.DateTimeFormat("en-US", {month: "long", year: "numeric"}).format(new Date());
const currencyFormatter = new Intl.NumberFormat("en-PK", {
    maximumFractionDigits: 0
});

const formatAmount = (value) => {
    const numericValue = Number(value) || 0;
    return currencyFormatter.format(Math.abs(numericValue));
};

const formatDate = (value) => {
    const dateValue = value ? new Date(value) : null;
    if (!dateValue || Number.isNaN(dateValue.getTime())) {
        return {date: "No date", time: "—"};
    }

    return {
        date: dateValue.toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric"
        }),
        time: dateValue.toLocaleTimeString("en-US", {
            hour: "numeric",
            minute: "2-digit"
        })
    };
};

const toTitleCase = (value) => String(value || "").replace(/\b\w/g, (letter) => letter.toUpperCase());

const transactionRows = rows.length
    ? rows.map((row, index) => {
            const formattedDate = formatDate(row.date);
            const type = String(row.type || "Expense").toLowerCase();
            const amountValue = Number(row.amount) || 0;
            const category = toTitleCase(row.category || "Uncategorized");

            return {
                id: row.id,
                date: formattedDate.date,
                time: formattedDate.time,
                description: row.description || "Transaction",
                note: row.category || "Personal",
                category,
                type: type === "income" ? "Income" : "Expense",
                amount: `${amountValue < 0 ? "-" : "+"} PKR ${formatAmount(amountValue)}`,
                method: row.method || "Cash",
                methodNote: row.method || "Primary wallet",
                tone: ["mint", "blue", "orange", "indigo", "green", "yellow"][index % 6],
                icon: type === "income" ? "bx bx-wallet" : "bx bx-cart"
            };
        })
        : [];

const totalIncome = rows
        .filter((row) => String(row.type || "").toLowerCase() === "income")
        .reduce((sum, row) => sum + (Number(row.amount) || 0), 0);
const totalExpenses = rows
        .filter((row) => String(row.type || "").toLowerCase() === "expense")
        .reduce((sum, row) => sum + Math.abs(Number(row.amount) || 0), 0);
const totalTransactions = rows.length;
const netBalance = totalIncome - totalExpenses;

const summaryCards = [
            {
                label: "Total Income",
                value: `PKR ${formatAmount(totalIncome)}`,
                tone: "mint",
                icon: "bx bx-arrow-up",
                delta: "Income"
            },
            {
                label: "Total Expenses",
                value: `PKR ${formatAmount(totalExpenses)}`,
                tone: "rose",
                icon: "bx bx-arrow-down",
                delta: "Expenses"
            },
            {
                label: "Net Balance",
                value: `PKR ${formatAmount(netBalance)}`,
                tone: "blue",
                icon: "bx bx-wallet",
                delta: "Balance"
            },
            {
                label: "Total Transactions",
                value: String(totalTransactions),
                tone: "violet",
                icon: "bx bx-list-ul",
                delta: "Recorded"
            }
        ];
%>

<main class="transaction-main">
    <section class="transaction-page">
        <header class="transaction-header">
            <div class="transaction-heading">
                <h1 class="transaction-title">Transactions</h1>
                <p class="transaction-subtitle">Manage and track all your income and expenses</p>
            </div>

            <div class="transaction-actions">
                <a class="transaction-action transaction-action--primary" type="button" href="/add-transaction"
                   style="text-decoration: none">
                    <i class="bx bx-plus"></i>
                    New Transaction
                </a>
                <button class="transaction-action transaction-action--ghost" type="button">
                    <i class="bx bx-calendar"></i>
                    <%= currentMonthLabel %>
                </button>
                <button class="transaction-icon-btn" type="button" aria-label="Notifications">
                    <i class="bx bx-bell"></i>
                </button>
            </div>
        </header>

        <section class="transaction-summary-grid" aria-label="Transaction summaries">
            <% summaryCards.forEach((card) => { %>
                <article class="summary-card summary-card--<%= card.tone %>">
                    <div class="summary-card__icon">
                        <i class="<%= card.icon %>"></i>
                    </div>
                    <div class="summary-card__content">
                        <span class="summary-card__label"><%= card.label %></span>
                        <strong class="summary-card__value"><%= card.value %></strong>
                        <div class="summary-card__meta">
                            <span>All time</span>
                            <span class="summary-card__delta"><%= card.delta %></span>
                        </div>
                    </div>
                </article>
            <% }); %>
        </section>

        <section class="transaction-table-card">
            <div class="transaction-toolbar">
                <label class="transaction-search" for="transactionSearch">
                    <i class="bx bx-search"></i>
                    <input id="transactionSearch" type="search" placeholder="Search transactions..."/>
                </label>

                <select class="transaction-select" id="transactionTypeFilter" aria-label="Transaction type filter">
                    <option value="" disabled selected>All Types</option>
                    <option>Income</option>
                    <option>Expense</option>
                </select>

                <select class="transaction-select" id="transactionCategoryFilter" aria-label="Category filter">
                    <option value="" disabled selected>All Categories</option>
                    <option value="Food">Food and dining</option>
                    <option value="Transportation">Transportation</option>
                    <option value="Rent">House Rent</option>
                    <option value="entertainment">Entertainment</option>
                    <option value="Shopping">Shopping</option>
                    <option value="Healthcare">Healthcare</option>
                    <option value="Personal Care">Personal care</option>
                    <option value="Saving">Saving and investment</option>
                    <option value="Other">Other</option>
                </select>

                <button class="transaction-action transaction-action--ghost transaction-filter-btn" id="transactionFilterBtn" type="button" aria-pressed="false">
                    <i class="bx bx-filter-alt"></i>
                    Filter
                </button>

                <a class="transaction-action transaction-action--ghost transaction-export-btn" href="/transaction/export/to/csv" style="text-decoration: none">
                    <i class="bx bx-download"></i>
                    Export
                </a>
            </div>

            <div class="transaction-table-wrap">
                <table class="transactions-table">
                    <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Payment Method</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    <% if (transactionRows.length) { %>
                    <% transactionRows.forEach((row) => { %>
                        <tr class="transaction-row" data-id="<%= row.id %>" data-category="<%= row.category %>" data-type="<%= row.type %>">
                            <td>
                                <div class="date-cell">
                                    <strong><%= row.date %></strong>
                                    <span><%= row.time %></span>
                                </div>
                            </td>
                            <td>
                                <div class="description-cell">
                                        <span class="description-cell__icon description-cell__icon--<%= row.tone %>">
                                            <i class="<%= row.icon %>"></i>
                                        </span>
                                    <div>
                                        <strong><%= row.description %></strong>
                                        <span><%= row.note %></span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="pill pill--<%= row.tone %>"><%= row.category %></span>
                            </td>
                            <td>
                                <span class="pill pill--<%= row.type.toLowerCase() %>"><%= row.type %></span>
                            </td>
                            <td>
                                <strong class="amount-cell amount-cell--<%= row.type.toLowerCase() %>"><%= row.amount %></strong>
                            </td>
                            <td>
                                <div class="payment-cell">
                                        <span class="payment-cell__icon payment-cell__icon--<%= row.tone %>">
                                            <i class="bx bx-credit-card"></i>
                                        </span>
                                    <div>
                                        <strong><%= row.method %></strong>
                                        <span><%= row.methodNote %></span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button class="action-dots" type="button" aria-label="Transaction actions"
                                            onclick="activeGoalDropdown(this)">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-content">
                                        <a href="/edit/transaction/<%= row.id %>">Edit Transaction</a>
                                        <a class="dropdown-delete">Delete Transaction</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                    <% } else { %>
                    <tr>
                        <td colspan="7">
                            <div class="transaction-empty-state">
                                <span class="transaction-empty-state__icon"><i class="bx bx-receipt"></i></span>
                                <strong>No transactions yet</strong>
                                <span>Add your first income or expense to start tracking your finances.</span>
                                <a class="transaction-action transaction-action--primary" href="/add-transaction">
                                    <i class="bx bx-plus"></i> Add transaction
                                </a>
                            </div>
                        </td>
                    </tr>
                    <% } %>
                    </tbody>
                </table>
            </div>

            <div class="table-footer">
                <p id="transactionRange">Showing <%= transactionRows.length ? 1 : 0 %> to <%= Math.min(transactionRows.length, 6) %> of <%= totalTransactions %> transactions</p>
                <nav class="pagination" aria-label="Transaction pagination">
                    <button type="button" class="pagination-prev" aria-label="Previous page">
                        <i class="bx bx-chevron-left"></i>
                    </button>
                    <% for (let page = 1; page <= Math.max(1, Math.ceil(transactionRows.length / 6)); page++) { %>
                        <button type="button" class="pagination-page <%= page === 1 ? 'is-active' : '' %>" data-page="<%= page %>"><%= page %></button>
                    <% } %>
                    <button type="button" class="pagination-next" aria-label="Next page">
                        <i class="bx bx-chevron-right"></i>
                    </button>
                </nav>
            </div>
        </section>
    </section>
</main>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var sidebarLink = document.querySelector('.sidebar .nav-link[href="/transaction"]');
        if (sidebarLink) {
            sidebarLink.classList.add("active");
        }
    });
</script>

<script src="/js/index.js"></script>